# Database Configuration
DB_URL=jdbc:postgresql://localhost:5435/payguard
DB_USER=payguard
DB_PASSWORD=your_secure_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here

# Application Configuration
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_secure_jwt_secret_here_min_32_chars
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://payguard.ng,https://app.payguard.ng

# Payment Processor (Paystack)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Identity Verification (Dojah)
DOJAH_CLIENT_ID=your_dojah_client_id_here
DOJAH_CLIENT_SECRET=your_dojah_client_secret_here
DOJAH_BASE_URL=https://api.dojah.io
DOJAH_BUSINESS_REF_ID=your_dojah_business_ref_id_here